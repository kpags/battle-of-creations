FROM node:22-alpine AS dependencies

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev


FROM node:22-alpine

RUN apk add --no-cache \
      postgresql16 \
      postgresql16-client \
      redis \
      su-exec \
      tini

WORKDIR /app

COPY --from=dependencies /app/node_modules ./node_modules
COPY . .

RUN chmod +x /app/scripts/render-all-in-one.sh \
    && mkdir -p /var/data /app/data \
    && chown -R node:node /app

ENV NODE_ENV=production \
    PORT=10000 \
    DATA_ROOT=/var/data \
    POSTGRES_DB=battle_of_creations \
    POSTGRES_PASSWORD=!Qaz2wsx \
    POSTGRES_USER=boc \
    PGPORT=5432 \
    REDIS_PORT=6379 \
    REDIS_MAXMEMORY=64mb \
    MEDIA_DIR=/var/data/media \
    PG_POOL_MAX=10

EXPOSE 10000

ENTRYPOINT ["/sbin/tini", "--", "/app/scripts/render-all-in-one.sh"]
